{
  "name": "bikefree",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test test/*.test.mjs",
    "routes:build": "node tools/build_routes.mjs",
    "routes:check": "node tools/build_routes.mjs --check",
    "qc": "node tools/qc_course.mjs",
    "qc:clipping": "node tools/qc_clipping.mjs",
    "qc:network": "node tools/qc_network.mjs",
    "qc:pgh": "node tools/qc_pgh.mjs",
    "pgh:build": "node tools/pgh_pipeline.mjs",
    "snap:pgh": "node tools/snap_pgh.mjs",
    "network:build": "node tools/build_network.mjs",
    "snap": "node tools/snap_scene.mjs",
    "snap:cam": "node tools/snap_cam.mjs",
    "snap:rider": "node tools/snap_rider.mjs",
    "lint:scenes": "node tools/lint_scene.mjs",
    "new-route": "node tools/new_route.mjs",
    "presets": "node tools/build_presets.mjs",
    "guard": "node tools/toolbox_guard.mjs",
    "gallery": "node tools/snap_gallery.mjs",
    "figures": "node tools/build_figures.mjs",
    "snap:figures": "node tools/snap_figures.mjs",
    "gallery:buildings": "node tools/snap_buildings.mjs",
    "pgh:edit": "echo 'PGH map editor: http://localhost:8000/tools/pgh-editor.html' && python3 -m http.server 8000",
    "pgh:after-edit": "node tools/pgh_after_edit.mjs",
    "cny:build": "python3 tools/build_pgh.py --city cny && python3 tools/pgh_city.py --city cny && python3 tools/cny_heroes.py && python3 tools/cny_forest.py && node tools/pgh_routes.mjs --city cny --write && node tools/qc_pgh.mjs routes/cities/cny.json --rides 200",
    "cny:routes": "node tools/pgh_routes.mjs --city cny",
    "skan:build": "python3 tools/build_pgh.py --city skan && python3 tools/pgh_city.py --city skan && node tools/pgh_routes.mjs --city skan --write && node tools/qc_pgh.mjs routes/cities/skan.json --rides 200",
    "qc:map": "node tools/qc_map.mjs",
    "qc:all": "node tools/qc.mjs",
    "qc:fix": "node tools/qc_fix.mjs",
    "qc:nyc": "node tools/qc_map.mjs nyc",
    "nyc:build": "python3 tools/build_pgh.py --city nyc && python3 tools/nyc_pools.py && python3 tools/pgh_city.py --city nyc && python3 tools/nyc_heroes.py && python3 tools/nyc_sync.py && node tools/pgh_routes.mjs --city nyc --write && node tools/qc_pgh.mjs routes/cities/nyc.json --rides 200",
    "skan:routes": "node tools/pgh_routes.mjs --city skan",
    "textures": "python3 tools/make_pbr_sets.py && node tools/build_textures.mjs",
    "gate": "node tools/webgpu_gate.mjs"
  },
  "devDependencies": {
    "@garmin/fitsdk": "^21.221.0",
    "ktx2-encoder": "^0.6.0",
    "playwright-core": "^1.65.1",
    "spectorjs": "^0.9.33",
    "three-mesh-bvh": "^0.9.18"
  },
  "version": "0.15.0"
}
